
{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "remote-dns",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        },
        "detour": "us-proxy"
      }
    ],
    "final": "remote-dns",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singtun",
      "address": [
        "172.19.0.1/30"
      ],
      "mtu": 1500,
      "auto_route": true,
      "strict_route": true,
      "dns_mode": "hijack"
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "us-proxy",
      "server": "YOUR_PROXY_IP",
      "server_port": 1080,
      "version": "5",
      "username": "YOUR_USERNAME",
      "password": "YOUR_PASSWORD",
      "network": "tcp"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "network": "udp",
        "action": "reject"
      },
      {
        "network": "icmp",
        "action": "reject"
      }
    ],
    "final": "us-proxy"
  }
}
