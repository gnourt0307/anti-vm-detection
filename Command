1. cd C:\sing-box
.\sing-box.exe check -c config.json
.\sing-box.exe run -c config.json

2. curl.exe -4 --max-time 15 https://api.ipify.org

Open Notepad and save this as:
C:\sing-box\enable-killswitch.ps1


# sing-box / VirtualBox Windows 10 guest - restrictive outbound firewall
# Run in Administrator PowerShell ONLY inside the VM.
# Requires sing-box TUN already working. Network may be interrupted.
# Repeat-safe for rules created by this script; makes a fresh firewall backup each run.
# NOTE: Existing enabled outbound allow rules can permit bypass, so this is NOT
# a proven fail-closed kill switch until those rules are audited and leak tests pass.

#Requires -RunAsAdministrator
$ErrorActionPreference = 'Stop'

$Folder = 'C:\sing-box'
$ProxyIP = '103.105.165.207'
$ProxyPort = 5597
$PhysicalInterface = 'Ethernet'
$TunInterface = 'singtun'
$Exe = Join-Path $Folder 'sing-box.exe'

if (-not (Test-Path -LiteralPath $Exe)) { throw "sing-box.exe not found: $Exe" }
if (-not (Get-NetAdapter -Name $PhysicalInterface -ErrorAction SilentlyContinue)) { throw "Missing adapter: $PhysicalInterface" }
if (-not (Get-NetAdapter -Name $TunInterface -ErrorAction SilentlyContinue)) { throw "Start sing-box first; missing TUN adapter: $TunInterface" }

$backup = Join-Path $Folder ("firewall-before-killswitch-{0}-{1}.wfw" -f (Get-Date -Format 'yyyyMMdd-HHmmss'), [guid]::NewGuid().ToString('N').Substring(0,6))
& netsh.exe advfirewall export "$backup" | Out-Host
if ($LASTEXITCODE -ne 0 -or -not (Test-Path -LiteralPath $backup)) { throw 'Firewall backup failed; no rules changed.' }
Write-Host "Backup: $backup" -ForegroundColor Cyan

# Remove only our previously created rules to avoid duplicates.
@('SB-Allow-Proxy', 'SB-Allow-TUN', 'SB-Allow-DHCP') | ForEach-Object {
  Get-NetFirewallRule -DisplayName $_ -ErrorAction SilentlyContinue | Remove-NetFirewallRule
}

New-NetFirewallRule -DisplayName 'SB-Allow-Proxy' -Direction Outbound -Action Allow `
  -Program $Exe -InterfaceAlias $PhysicalInterface -Protocol TCP `
  -RemoteAddress $ProxyIP -RemotePort $ProxyPort -Profile Public | Out-Null

New-NetFirewallRule -DisplayName 'SB-Allow-TUN' -Direction Outbound -Action Allow `
  -InterfaceAlias $TunInterface -Profile Public | Out-Null

New-NetFirewallRule -DisplayName 'SB-Allow-DHCP' -Direction Outbound -Action Allow `
  -InterfaceAlias $PhysicalInterface -Protocol UDP -LocalPort 68 -RemotePort 67 -Profile Public | Out-Null

# Default-deny applies only where no other enabled allow rule matches.
# We deliberately do not mass-disable Windows system rules.
Set-NetFirewallProfile -Profile Public -Enabled True -DefaultOutboundAction Block

Write-Host "`nPublic profile outbound default: Block" -ForegroundColor Green
Write-Host 'Rules installed: SB-Allow-Proxy, SB-Allow-TUN, SB-Allow-DHCP'
Write-Warning 'Existing outbound Allow rules can still permit direct traffic. This is not a verified kill switch.'
Write-Host 'TEST with sing-box running: curl.exe -4 --max-time 10 https://api.ipify.org'
Write-Host 'TEST after stopping sing-box: repeat curl; it must fail, NOT show your host IP.'
Write-Host "ROLLBACK (Administrator): netsh advfirewall import `"$backup`""


4. Active it:
With sing-box running, open another Administrator PowerShell window and execute:

powershell.exe -ExecutionPolicy Bypass -File "C:\sing-box\enable-killswitch.ps1"

5. Whenever you restart the VM, open Administrator PowerShell:
cd C:\sing-box
.\sing-box.exe run -c config.json

