1. Get-NetRoute -AddressFamily IPv4 |
    Sort-Object RouteMetric |
    Format-Table DestinationPrefix, InterfaceAlias, NextHop, RouteMetric

2. curl.exe -4 --max-time 15 https://api.ipify.org

3. curl.exe -6 --max-time 10 https://api6.ipify.org

4. New-NetFirewallRule `
  -DisplayName "SB-Allow-Proxy" `
  -Direction Outbound `
  -Action Allow `
  -Program "C:\sing-box\sing-box.exe" `
  -InterfaceAlias "Ethernet" `
  -Protocol TCP `
  -RemoteAddress "103.105.165.207" `
  -RemotePort 5597 `
  -Profile Public

5. New-NetFirewallRule `
  -DisplayName "SB-Allow-TUN" `
  -Direction Outbound `
  -Action Allow `
  -InterfaceAlias "singtun" `
  -Profile Public

6. Get-NetFirewallRule -Enabled True -Direction Outbound -Action Allow |
    Select-Object DisplayName, Name, Profile |
    Format-Table -AutoSize

7. Get-NetFirewallRule -DisplayName "SB-Allow-*"

